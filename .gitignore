# Build inputs and outputs
/base-apk/*.apk
/dist/*
!/dist/.gitkeep
/.gradle/
/local.properties
/**/build/

# Signing material must never be committed
/signing/*
!/signing/README.md
*.p12
*.jks
*.keystore
*.pem
*.key

# Local configuration and editor files
.env
.env.*
!.env.example
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Python caches
__pycache__/
*.py[cod]
.venv/

# Temporary files
*.tmp
*.bak
*.log
androguard.db*
