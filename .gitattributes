# Frozen image assets are stored as ordinary Git blobs for complete checkouts.
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text

# APKs belong in GitHub Releases, not ordinary commits. This rule is retained
# for private remotes that intentionally version a base APK with Git LFS.
*.apk filter=lfs diff=lfs merge=lfs -text

*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf

